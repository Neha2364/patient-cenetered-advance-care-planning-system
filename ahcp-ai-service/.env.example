# Required: private shared secret used by the main backend to call this AI service
AHCP_AI_SERVICE_API_KEY=replace-with-a-long-random-secret

# Required only for live OpenRouter generation; never commit the real key
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Optional: defaults to ./knowledge
AHCP_KNOWLEDGE_DIR=./knowledge
AHCP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
