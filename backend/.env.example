# Flask Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase Storage Configuration
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=[your-supabase-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[your-supabase-service-role-key]
SUPABASE_BUCKET=amd-documents

# JWT Security
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# AHCP AI Service Configuration (FastAPI microservice)
AHCP_AI_BASE_URL=http://127.0.0.1:8000
AHCP_AI_SERVICE_API_KEY=[your-ahcp-ai-service-api-key]
AHCP_AI_TIMEOUT_SECONDS=15

